# Copie para .env na raiz; este banco pertence exclusivamente à migração Haru.
# SQLite em arquivo. O dialeto do SQL é o mesmo aceito pelo Cloudflare D1,
# para que a troca futura de driver não exija reescrever consultas.
DATABASE_FILE=.local/haru.db
TEST_DATABASE_FILE=.local/haru_test.db
API_HOST=127.0.0.1
API_PORT=3001
# WEB_ORIGIN precisa corresponder ao endereço usado no navegador.
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# API_URL é lida pelo proxy do Next em runtime; não é exposta no bundle do cliente.
API_URL=http://127.0.0.1:3001
