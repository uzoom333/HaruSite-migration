# Copie para apps/api/.env. Nunca versione o .env.
DATABASE_FILE=apps/api/.local/haru.db
TEST_DATABASE_FILE=apps/api/.local/haru_test.db
API_HOST=127.0.0.1
API_PORT=3001
# Origens do site, separadas por vírgula, sem caminho (ex.: https://usuario.github.io).
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Quantidade de proxies na frente da API (0 = nenhum). Afeta o limite por IP.
TRUST_PROXY=0
# Chave das rotas administrativas: no mínimo 32 caracteres (openssl rand -hex 32).
ADMIN_KEY=

# sandbox ou production. Contas, apps e tokens são separados em cada ambiente.
MELHOR_ENVIO_ENV=sandbox
# Exigido pela API: "Nome da aplicação (email de contato técnico)".
MELHOR_ENVIO_USER_AGENT=
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# Idêntico ao callback cadastrado no app; termina em /api/melhor-envio/callback.
MELHOR_ENVIO_REDIRECT_URI=
# Opcional: token fixo. Se preenchido, substitui o OAuth e não é renovado.
MELHOR_ENVIO_TOKEN=
# Opcional: ids de serviço separados por vírgula. Vazio = todos da conta.
MELHOR_ENVIO_SERVICES=
SHIP_FROM_CEP=

# Remetente: usado só para criar etiquetas.
SHIP_FROM_NAME=
SHIP_FROM_DOCUMENT=
SHIP_FROM_COMPANY_DOCUMENT=
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
SHIP_FROM_ADDRESS=
SHIP_FROM_NUMBER=
SHIP_FROM_DISTRICT=
SHIP_FROM_CITY=
SHIP_FROM_UF=
