{
  "name": "haru-migration",
  "version": "5.5.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @haru/api\" \"npm run dev -w @haru/web\"",
    "build": "npm run build -w @haru/api && npm run build -w @haru/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:legacy && npm run test -w @haru/api",
    "test:legacy": "node --test tests/*.test.cjs",
    "build:legacy": "node scripts/build.cjs",
    "start:legacy": "node scripts/serve.cjs",
    "db:migrate": "npm run db:migrate -w @haru/api",
    "test:e2e": "playwright test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,json}\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
